{
  "files.watcherExclude": {
    "**/target/**": true,
    "**/.git/**": true
  },
  "search.exclude": {
    "**/target/**": true
  },

  "rust-analyzer.checkOnSave.command": "check",
  "rust-analyzer.cargo.buildScripts.enable": false,
  "rust-analyzer.procMacro.enable": false,
  "rust-analyzer.cargo.loadOutDirsFromCheck": false
}